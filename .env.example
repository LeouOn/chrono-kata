# ==============================================================================
# chrono-kata — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local for local development on PC / Linux / macOS:
#   cp .env.example .env.local
#
# On mobile / Android PWA, you can also configure API keys directly inside the
# app via the in-app LLM Settings screen (/llm).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Calendar 1-Way Sync (Optional)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client ID for Google Identity Services (GIS)
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# ------------------------------------------------------------------------------
# 2. Active LLM Provider (Optional)
# ------------------------------------------------------------------------------
# Set which provider to use by default on first load (e.g. openrouter, openai, claude, gemini, etc.)
NEXT_PUBLIC_DEFAULT_PROVIDER=openrouter

# ------------------------------------------------------------------------------
# 3. LLM Provider API Keys & Overrides (Optional)
# ------------------------------------------------------------------------------
# OpenRouter (Supports 200+ models: Claude, GPT-4o, MiniMax, Llama 3, DeepSeek, etc.)
NEXT_PUBLIC_OPENROUTER_API_KEY=
# NEXT_PUBLIC_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# NEXT_PUBLIC_OPENROUTER_MODEL=anthropic/claude-sonnet-latest

# OpenAI
NEXT_PUBLIC_OPENAI_API_KEY=
# NEXT_PUBLIC_OPENAI_BASE_URL=https://api.openai.com/v1
# NEXT_PUBLIC_OPENAI_MODEL=gpt-4o

# Anthropic Claude
NEXT_PUBLIC_ANTHROPIC_API_KEY=
# NEXT_PUBLIC_CLAUDE_BASE_URL=https://api.anthropic.com/v1
# NEXT_PUBLIC_CLAUDE_MODEL=claude-sonnet-4-20250514

# Google Gemini
NEXT_PUBLIC_GEMINI_API_KEY=
# NEXT_PUBLIC_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# NEXT_PUBLIC_GEMINI_MODEL=gemini-2.0-flash

# DeepSeek
NEXT_PUBLIC_DEEPSEEK_API_KEY=
# NEXT_PUBLIC_DEEPSEEK_BASE_URL=https://api.deepseek.com
# NEXT_PUBLIC_DEEPSEEK_MODEL=deepseek-v4-flash

# Zhipu AI / GLM
NEXT_PUBLIC_ZAI_API_KEY=
# NEXT_PUBLIC_ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# NEXT_PUBLIC_ZAI_MODEL=glm-5.2

# MiniMax
NEXT_PUBLIC_MINIMAX_API_KEY=
# NEXT_PUBLIC_MINIMAX_BASE_URL=https://api.minimax.io/v1
# NEXT_PUBLIC_MINIMAX_MODEL=minimax-m3

# Nvidia Nemotron
NEXT_PUBLIC_NEMOTRON_API_KEY=
# NEXT_PUBLIC_NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# NEXT_PUBLIC_NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# Local Ollama (No API key required)
# NEXT_PUBLIC_OLLAMA_ENABLED=true
# NEXT_PUBLIC_OLLAMA_BASE_URL=http://localhost:11434/v1
# NEXT_PUBLIC_OLLAMA_MODEL=llama3.3
