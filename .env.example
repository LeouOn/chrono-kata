# ==============================================================================
# chrono-kata — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local for local development on PC / Linux / macOS:
#   cp .env.example .env.local
#
# Both standard environment variables (e.g. OPENAI_API_KEY, ANTHROPIC_API_KEY)
# and NEXT_PUBLIC_* prefixed variables are supported!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Calendar 1-Way Sync (Optional)
# ------------------------------------------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=your_client_id_here
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your_client_id_here

# ------------------------------------------------------------------------------
# 2. Active LLM Provider (Optional)
# ------------------------------------------------------------------------------
# Default active provider on first load (e.g. openrouter, openai, claude, gemini, etc.)
DEFAULT_PROVIDER=openrouter

# ------------------------------------------------------------------------------
# 3. LLM Provider API Keys & Overrides (Standard & NEXT_PUBLIC_ supported)
# ------------------------------------------------------------------------------

# OpenRouter (Supports 200+ models: Claude, GPT-4o, MiniMax, Llama 3, DeepSeek, etc.)
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=anthropic/claude-sonnet-latest

# OpenAI
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=
# CLAUDE_BASE_URL=https://api.anthropic.com/v1
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Google Gemini
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-2.0-flash

# DeepSeek
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# Zhipu AI / GLM
ZAI_API_KEY=
# ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZAI_MODEL=glm-5.2

# MiniMax
MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_MODEL=minimax-m3

# Nvidia Nemotron
NEMOTRON_API_KEY=
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1

# Local Ollama (No API key required)
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.3
